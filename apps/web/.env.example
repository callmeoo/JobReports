# Database (Neon / Supabase / local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
# Vercel 上四个变量都必须配置，且不要带引号
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_PASSWORD="your-login-password"
AUTH_TRUST_HOST="true"
# 可选，Vercel 自定义域名时设置，如 https://your-app.vercel.app
# AUTH_URL="https://your-app.vercel.app"

# Optional — defaults to the two emails configured in code
ALLOWED_EMAILS="yuanlj0119@gmail.com,935170143@qq.com"

# AI summarization (optional — falls back to rule-based if unset)
OPENAI_API_KEY="sk-..."
# AI_API_KEY="..."           # alternative to OPENAI_API_KEY
# AI_BASE_URL="https://api.openai.com/v1"
# AI_MODEL="gpt-4o-mini"
